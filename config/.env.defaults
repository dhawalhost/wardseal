# WardSeal Default Configuration
# This file contains non-sensitive defaults checked into git.
# Secrets should be provided via Vault or environment variables.

# Environment
ENVIRONMENT=development

# Database (Standardized for gokit)
APP_DATABASE_DSN=postgres://user:password@localhost:5432/identity_platform?sslmode=disable

# Service URLs
APP_AUTH_BASE_URL=http://localhost:8080
APP_AUTH_DIRECTORY_SERVICE_URL=http://localhost:8081
APP_GOVERNANCE_DIRECTORY_SERVICE_URL=http://localhost:8081
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional Redis (used for transient auth session state)
# Leave APP_REDIS_ADDR empty to use in-memory fallback stores.
APP_REDIS_ADDR=
APP_REDIS_DB=0
WEBAUTHN_SESSION_TTL_SECONDS=600

# Distributed rate limit profiles (authsvc)
RATE_LIMIT_USE_TENANT=true
RATE_LIMIT_KEY_PREFIX=authsvc:ratelimit
RATE_LIMIT_DEFAULT_REQUESTS=1200
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=60
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_TOKEN_REQUESTS=240
RATE_LIMIT_TOKEN_WINDOW_SECONDS=60
RATE_LIMIT_SETUP_REQUESTS=30
RATE_LIMIT_SETUP_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_REQUESTS=600
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
RATE_LIMIT_DEGRADED_REQUESTS=30
RATE_LIMIT_DEGRADED_WINDOW_SECONDS=60

# Service-to-service auth header
SERVICE_AUTH_HEADER=X-Service-Auth

# Logging
APP_LOG_LEVEL=info

# Enterprise License (optional)
REQUIRE_LICENSE=false
LICENSE_PUBLIC_KEY_PATH=/etc/wardseal/license_public.pem
